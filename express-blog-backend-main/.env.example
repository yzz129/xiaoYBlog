NODE_ENV=development
PORT=8002

ALLOW_CLIENT=localhost:3000,127.0.0.1:3000,localhost:8080,127.0.0.1:8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=blog
MYSQL_MULTIPLE_STATEMENTS=false
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_CONNECTION_LIMIT=8
MYSQL_QUEUE_LIMIT=100
MYSQL_CHARSET=UTF8MB4_UNICODE_CI

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_RETRY_AFTER_MS=30000

JWT_SECRET=blog-secret-key
JWT_EXPIRE_DAYS=3
# 生产环境请设置独立、足够长的随机值；留空时兼容回退到 JWT_SECRET。
SESSION_SECRET=
SESSION_COOKIE_NAME=blog_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_MS=21600000
SESSION_STORE=redis
SESSION_REDIS_PREFIX=blog:session:
AUTH_COOKIE_NAME=blog_token
AUTH_CSRF_COOKIE_NAME=blog_csrf
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false

EMAIL_SERVICE=163
EMAIL_PORT=465
EMAIL_SECURE_CONNECTION=true
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
AUTHOR_EMAIL=
BLOG_NAME=小Y 博客
SITE_URL=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-mini

BAIDU_API_KEY=
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com
BAIDU_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_KNOWLEDGE_CUTOFF=2024-12
AI_SESSION_TTL_SECONDS=21600
AI_REQUEST_TIMEOUT_MS=45000

# 宠物 Agent：按顺序自动故障转移。OpenRouter 被强制限制为免费路由或 :free 模型。
PET_AGENT_PROVIDER_ORDER=agnes,openrouter,openai,deepseek
PET_AGENT_REQUEST_TIMEOUT_MS=120000
PET_AGENT_MAX_STEPS=24
PET_AGENT_MAX_RETRIES=3
PET_AGENT_LEASE_SECONDS=90
PET_AGENT_MAX_CONCURRENCY=3
PET_AGENT_MAX_ACTIVE_TASKS_PER_USER=5
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=openrouter/free
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_AGENT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
# 留空时不调用；只有实时目录确认价格全部为 0 的模型才会执行。
POLLINATIONS_IMAGE_MODEL=

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blog-assets
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
